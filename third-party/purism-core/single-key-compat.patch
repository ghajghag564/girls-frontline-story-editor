--- a/src/verify.c
+++ b/src/verify.c
@@ -118,6 +118,33 @@
 #undef psm__predicate_static
 #undef psm__predicate_dynamic
   return PSM__OK;
+}
+
+/* A table with a single key always has zero interpolation weight. Storage
+ * and the verified source window must use the same number of reachable
+ * corners. Check every index here as arena sizing can precede model init. */
+PSM__DEF psm__i32
+psm__binding_blend_capacity(const struct psm__sections *src,
+    const struct psm__count_info *cnt, psm__i32 bi)
+{
+  if (!psm__valid_idx(bi, cnt->bindings) ||
+      !src->binding_src.key_table_idx_len || !src->binding_src.key_table_idx_off)
+    return 0;
+  psm__i32 len = src->binding_src.key_table_idx_len[bi];
+  if (len == 0) return 1;
+  psm__i32 off = src->binding_src.key_table_idx_off[bi];
+  if (len < 0 || len > PSM__MAX_KEY_TABLES ||
+      !psm__valid_range(off, len, cnt->key_table_idx) ||
+      !src->key_table_idx_src.idx || !src->key_table_src.keys_len)
+    return 0;
+  psm__u32 axes = 0;
+  for (psm__i32 i = 0; i < len; i++) {
+    psm__i32 table = src->key_table_idx_src.idx[off + i];
+    if (!psm__valid_idx(table, cnt->key_tables) ||
+        src->key_table_src.keys_len[table] < 0) return 0;
+    if (src->key_table_src.keys_len[table] > 1) axes++;
+  }
+  return (psm__i32)(1u << axes);
 }
 
