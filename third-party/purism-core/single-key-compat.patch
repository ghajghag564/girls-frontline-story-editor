     psm__u32 *offsets, psm_size n, psm_size off, psm__u8 ver, bool bounds);
 
+PSM__DEF psm__i32 psm__binding_blend_capacity(const struct psm__sections *src,
+    const struct psm__count_info *cnt, psm__i32 bi);
+
